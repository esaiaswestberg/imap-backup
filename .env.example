# Directory where emails will be stored
BACKUP_OUTPUT_DIR=./output

# Interval between backup runs in minutes
BACKUP_INTERVAL_MINUTES=60

# Path to the accounts configuration file
BACKUP_ACCOUNTS_FILE=accounts.yaml

# Whether to run continuously on an interval (true/false)
BACKUP_RUN_ON_INTERVAL=false

# Whether to use IMAP IDLE to listen for new emails (real-time) (true/false)
BACKUP_IDLE=false
